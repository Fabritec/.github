# ---------------------------------------------------------------------------
# Fabritec Lead Intelligence — environment
#
# Copy to .env.local and fill in what you have. Nothing here is required to try
# the app: with no keys at all, `npm run campaign -- --dry-run` exercises the
# whole pipeline against bundled fixtures and writes a real workbook.
# ---------------------------------------------------------------------------

# --- AI enrichment (required for live runs) --------------------------------
# Without this, companies are stored unenriched and land in the review queue.
ANTHROPIC_API_KEY=
# Enrichment is high-volume and schema-constrained, so the default is the
# mid-tier model. Override for a slower, more careful pass.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# --- Database (source of truth) --------------------------------------------
# Leave both blank to use the local JSON store instead (good for trying it out,
# not for a team). Run supabase/migrations/0001_init.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Force a driver: 'supabase' or 'json'. Auto-detected when unset.
LEAD_STORE_DRIVER=
LEAD_STORE_JSON_PATH=.data/store.json

# --- Discovery sources ------------------------------------------------------
# Google Places (New) — the workhorse for MENA fabricators. Enable the
# "Places API (New)" in your Google Cloud project.
GOOGLE_PLACES_API_KEY=

# Apollo — company search, and the people layer once a company is a fit.
APOLLO_API_KEY=

# Hunter — email finding and verification.
HUNTER_API_KEY=

# --- Google Sheets sync (the shared team view) ------------------------------
# Create a service account, download its JSON key, then share the spreadsheet
# with the service account's email address as an Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key on one line, keeping the literal \n sequences.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Pipeline tuning --------------------------------------------------------
PIPELINE_CONCURRENCY=4
PIPELINE_MAX_SITE_CHARS=24000
PIPELINE_REQUEST_TIMEOUT_MS=20000
EXPORT_DIR=exports

# debug | info | warn | error
LOG_LEVEL=info
